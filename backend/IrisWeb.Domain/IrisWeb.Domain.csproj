<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Única dependência do Domain, e é matemática, não infraestrutura: `TensorPrimitives`
    calcula a distância entre dois vetores faciais com SIMD. "Quão parecidos são estes dois
    rostos" é regra de domínio; deixar isso na Application só para manter o csproj vazio
    esvaziaria a entidade sem ganhar nada.
  -->
  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.10" />
  </ItemGroup>

</Project>
