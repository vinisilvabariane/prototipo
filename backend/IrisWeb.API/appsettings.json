{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [ "http://localhost:5173", "https://localhost:5173" ]
  },
  "ConnectionStrings": {
    "Iris": ""
  },
  "FaceRecognition": {
    "ModelVersion": "inception_resnet_v1_aligned",
    "MatchTopK": 2,
    "DistanceThreshold": 0.85,
    "DistanceMargin": 0.12,
    "Enrollment": {
      "SamePersonDistance": 0.5,
      "SimilarDistance": 1.0,
      "MaxSpread": 0.7
    }
  },

  "ModelStorage": {
    "Path": "Data/model-artifacts"
  },
  "StaleSessionReaper": {
    "IntervalMinutes": 30,
    "MaxOpenHours": 48
  },
  "Swagger": {
    "Enabled": false
  },
  "Sync": {
    "BaseUrl": "https://sync.grupomultilaser.com.br/api/",
    "TimeoutSeconds": 15
  },
  "Jwt": {
    "Key": "",
    "Issuer": "access-control",
    "Audiences": [ "q-zero", "master-data" ],
    "ExpirationInMinutes": 15,
    "RefreshTokenExpirationInHours": 8
  },
  "Email": {
    "SmtpServer": "",
    "Port": 587,
    "FromAddress": "",
    "FromName": "IrisWeb",
    "User": "",
    "Password": "",
    "TimeoutSeconds": 15
  },
  "RateLimiting": {
    "AnonymousCredentialsPerMinute": 30
  }
}
